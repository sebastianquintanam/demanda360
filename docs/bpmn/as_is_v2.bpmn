<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_Demanda360_ASIS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:documentation>AS-IS: Proceso de planificación y generación de pedidos de Pinturas By-plus (Entregable 1, corregido). Pendientes por validar con los propietarios: disparador del inicio, plazo del temporizador, ruta tras el temporizador y fricción D.</bpmn:documentation>
  <bpmn:collaboration id="Colab_ASIS">
    <bpmn:participant id="Part_ByPlus" name="Pinturas By-plus" processRef="Proc_ASIS" />
    <bpmn:participant id="Proveedor" name="Proveedor" />
    <bpmn:messageFlow id="M_Solicitud" name="Solicitud de pedido" sourceRef="T_Pedido" targetRef="Proveedor" />
    <bpmn:messageFlow id="M_Falta" name="Aviso de falta de disponibilidad" sourceRef="Proveedor" targetRef="EV_Falta" />
    <bpmn:messageFlow id="M_Confirmacion" name="Confirmación y fecha estimada" sourceRef="Proveedor" targetRef="EV_Confirmacion" />
    <bpmn:textAnnotation id="A_M">
      <bpmn:text>M – El conteo de las existencias se realiza manualmente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS_M" associationDirection="None" sourceRef="A_M" targetRef="T_Conteo" />
    <bpmn:textAnnotation id="A_I">
      <bpmn:text>I – Información: No se registran las ventas por producto, lo que dificulta identificar cuáles tienen mayor o menor rotación.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS_I" associationDirection="None" sourceRef="A_I" targetRef="T_Determinar" />
    <bpmn:textAnnotation id="A_D">
      <bpmn:text>D – Duplicidad potencial: La lista de compra podría tener que escribirse nuevamente para enviarla por WhatsApp. Esto está pendiente de confirmar con los propietarios.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS_D" associationDirection="None" sourceRef="A_D" targetRef="T_Lista" />
    <bpmn:textAnnotation id="A_E">
      <bpmn:text>E – Espera: Se debe esperar la respuesta del proveedor, pero todavía no se conoce cuánto tarda. La entrega suele tomar entre 2 y 5 días después de confirmar el pedido.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS_E" associationDirection="None" sourceRef="A_E" targetRef="GW_Espera" />
    <bpmn:textAnnotation id="A_T">
      <bpmn:text>T – Trazabilidad: No existe un registro organizado para hacer seguimiento a los pedidos, las respuestas de los proveedores y los productos agotados.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS_T" associationDirection="None" sourceRef="A_T" targetRef="T_Pedido" />
    <bpmn:textAnnotation id="A_Ruta">
      <bpmn:text>Si el proveedor no responde, se propone consultar a otro proveedor. Pendiente de confirmar con los propietarios.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS_Ruta" associationDirection="None" sourceRef="A_Ruta" targetRef="T_Alternativo" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_ASIS" name="Planificación y generación de pedidos (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Propietarios" name="Propietarios">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Conteo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Determinar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_SinPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Proveedor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Une1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EV_Confirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_Confirmado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EV_Falta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EV_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Une2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Alternativo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Necesidad de revisar el abastecimiento (motivo de inicio por confirmar)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Conteo" name="Realizar conteo físico de existencias">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Determinar" name="Determinar productos y cantidades a solicitar">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Pedido" name="¿Es necesario realizar un pedido?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_No</bpmn:outgoing>
      <bpmn:outgoing>F_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fin_SinPedido" name="Fin sin pedido">
      <bpmn:incoming>F_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_Lista" name="Elaborar lista de compra">
      <bpmn:incoming>F_Si</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Proveedor" name="Seleccionar proveedor según producto y marca">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Une1">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Pedido" name="Realizar pedido al proveedor">
      <bpmn:incoming>F5b</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="GW_Espera" name="Esperar respuesta del proveedor">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="EV_Confirmacion" name="Confirmación y fecha recibidas">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Confirmacion" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Fin_Confirmado" name="Pedido confirmado">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="EV_Falta" name="Falta de disponibilidad notificada">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Falta" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="EV_Timer" name="No se recibe respuesta del proveedor (tiempo por definir)">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_SinRespuesta" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_Une2">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Alternativo" name="Seleccionar proveedor alternativo">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="T_Conteo" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Conteo" targetRef="T_Determinar" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Determinar" targetRef="GW_Pedido" />
    <bpmn:sequenceFlow id="F_No" name="No" sourceRef="GW_Pedido" targetRef="Fin_SinPedido" />
    <bpmn:sequenceFlow id="F_Si" name="Sí" sourceRef="GW_Pedido" targetRef="T_Lista" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Lista" targetRef="T_Proveedor" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Proveedor" targetRef="GW_Une1" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Alternativo" targetRef="GW_Une1" />
    <bpmn:sequenceFlow id="F5b" sourceRef="GW_Une1" targetRef="T_Pedido" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_Pedido" targetRef="GW_Espera" />
    <bpmn:sequenceFlow id="F7" sourceRef="GW_Espera" targetRef="EV_Confirmacion" />
    <bpmn:sequenceFlow id="F8" sourceRef="GW_Espera" targetRef="EV_Falta" />
    <bpmn:sequenceFlow id="F9" sourceRef="GW_Espera" targetRef="EV_Timer" />
    <bpmn:sequenceFlow id="F10" sourceRef="EV_Confirmacion" targetRef="Fin_Confirmado" />
    <bpmn:sequenceFlow id="F11" sourceRef="EV_Falta" targetRef="GW_Une2" />
    <bpmn:sequenceFlow id="F12" sourceRef="EV_Timer" targetRef="GW_Une2" />
    <bpmn:sequenceFlow id="F14" sourceRef="GW_Une2" targetRef="T_Alternativo" />
  </bpmn:process>
