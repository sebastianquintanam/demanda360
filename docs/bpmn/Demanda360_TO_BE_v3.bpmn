<bpmn:sequenceFlow id="B26c" name="No" sourceRef="GW_Otro" targetRef="Fin_SinProveedor" />
<bpmn:sequenceFlow id="B27" sourceRef="T_Alt" targetRef="T_Actualizar" />
<bpmn:sequenceFlow id="B28" sourceRef="T_Actualizar" targetRef="GW_Reenvio" />
