<bpmn:sequenceFlow id="B17" sourceRef="GW_Espera" targetRef="EV_Falta" />
<bpmn:sequenceFlow id="B18" sourceRef="GW_Espera" targetRef="EV_Timer" />
<bpmn:sequenceFlow id="B19" sourceRef="EV_Conf" targetRef="T_RegConf" />
<bpmn:sequenceFlow id="B20" sourceRef="T_RegConf" targetRef="Fin_Conf" />
<bpmn:sequenceFlow id="B21" sourceRef="EV_Falta" targetRef="GW_UneCambio" />
<bpmn:sequenceFlow id="B22" sourceRef="EV_Timer" targetRef="GW_Hora" />
<bpmn:sequenceFlow id="B23" name="Sí" sourceRef="GW_Hora" targetRef="GW_UneCambio" />
<bpmn:sequenceFlow id="B24" name="No: seguir esperando" sourceRef="GW_Hora" targetRef="GW_Amplia" />
<bpmn:sequenceFlow id="B25" sourceRef="GW_UneCambio" targetRef="T_Cancelar" />
<bpmn:sequenceFlow id="B26" sourceRef="T_Cancelar" targetRef="GW_Otro" />
