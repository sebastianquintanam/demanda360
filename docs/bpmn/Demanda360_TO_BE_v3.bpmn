<bpmn:sequenceFlow id="A2" sourceRef="T_Atencion" targetRef="GW_Saldo" />
<bpmn:sequenceFlow id="A3" name="Sí" sourceRef="GW_Saldo" targetRef="Fin_Rechazo" />
<bpmn:sequenceFlow id="A3b" name="No" sourceRef="GW_Saldo" targetRef="GW_Entrega" />
<bpmn:sequenceFlow id="A4" name="Sí" sourceRef="GW_Entrega" targetRef="T_Guardar" />
<bpmn:sequenceFlow id="A4b" name="No (entregado = 0)" sourceRef="GW_Entrega" targetRef="T_NoAtendida" />
<bpmn:sequenceFlow id="A4c" sourceRef="T_NoAtendida" targetRef="Fin_NoAtendida" />
<bpmn:sequenceFlow id="A5" sourceRef="T_Guardar" targetRef="GW_Umbral" />
