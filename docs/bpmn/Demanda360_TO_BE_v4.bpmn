<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_Demanda360_TOBE_v4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
<bpmn:documentation>TO-BE propuesto de Demanda360 (v4, 8 nov 2026). Proceso principal: planificación y generación de pedidos hasta Pedido confirmado. Procesos operativos relacionados: atención al cliente y alerta de stock crítico (P0) y entrada de mercancía (P0). [P0] obligatorio del MVP y [P1] segunda prioridad; ambos con código integrado en main (PR #5 y #6), revisados solo con mocks y sin verificación contra PostgreSQL. [Manual] fuera del sistema. Espera del proveedor según AS-IS v3 (30 minutos; límite de una hora desde el primer contacto con cada proveedor). Un pedido se reintenta una sola vez y el reintento nace APROBADO.</bpmn:documentation>
<bpmn:category id="Cat_CV_Entrada"><bpmn:categoryValue id="CV_Entrada" value="Proceso relacionado: entrada de mercancía (P0)" /></bpmn:category><bpmn:category id="Cat_CV_Atencion"><bpmn:categoryValue id="CV_Atencion" value="Proceso operativo: atención al cliente y alerta de stock crítico (P0)" /></bpmn:category>
<bpmn:collaboration id="Colab_TOBE">
<bpmn:participant id="Proveedor" name="Proveedor" />
<bpmn:participant id="Part_ByPlus" name="Pinturas By-plus con Demanda360 (TO-BE propuesto)" processRef="Proc_TOBE" />
<bpmn:messageFlow id="M_Solicitud" name="Solicitud de pedido" sourceRef="T_Enviar" targetRef="Proveedor" /><bpmn:messageFlow id="M_Conf" name="Confirmación y fecha estimada" sourceRef="Proveedor" targetRef="EV_Conf" /><bpmn:messageFlow id="M_Falta" name="Aviso de falta de disponibilidad" sourceRef="Proveedor" targetRef="EV_Falta" /><bpmn:messageFlow id="M_Entrega" name="Entrega de mercancía" sourceRef="Proveedor" targetRef="Inicio_Entrada" />
</bpmn:collaboration>
<bpmn:process id="Proc_TOBE" name="Planificación y generación de pedidos (TO-BE)" isExecutable="false">
<bpmn:laneSet id="LaneSet_TOBE"><bpmn:lane id="L_Prop" name="Propietario"><bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Tablero</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Conteo</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Conteo</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_UneConteo</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Determinar</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Pedido</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_SinPedido</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Borrador</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Aprobar</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Reenvio</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Enviar</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Amplia</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Espera</bpmn:flowNodeRef><bpmn:flowNodeRef>EV_Conf</bpmn:flowNodeRef><bpmn:flowNodeRef>T_RegConf</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_Conf</bpmn:flowNodeRef><bpmn:flowNodeRef>EV_Falta</bpmn:flowNodeRef><bpmn:flowNodeRef>EV_Timer</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Hora</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_UneCambio</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Otro</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Alt</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Reintento</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Cancelar</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_SinProveedor</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_Trab" name="Trabajador"><bpmn:flowNodeRef>Inicio_Entrada</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Entrada</bpmn:flowNodeRef><bpmn:flowNodeRef>Inicio_Atencion</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Atencion</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_App" name="Demanda360: aplicación (Flask y PostgreSQL)"><bpmn:flowNodeRef>GW_EConteo</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_ESinConteo</bpmn:flowNodeRef><bpmn:flowNodeRef>T_GuardarEntrada</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_Entrada</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Sugeridos</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Entrega</bpmn:flowNodeRef><bpmn:flowNodeRef>T_NoAtendida</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_NoAtendida</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_SinConteo</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_SinConteo</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Saldo</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_Rechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Guardar</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Umbral</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_SinAlerta</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Alerta</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Envio</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Enviada</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_Enviada</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Fallida</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Intentos</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin_Fallida</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ReintAlerta</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_N8N" name="Demanda360: n8n"><bpmn:flowNodeRef>GW_UneRe</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Correo</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Inicio_Entrada" name="Llega la mercancía"><bpmn:outgoing>E1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_Entrada" /></bpmn:startEvent>
<bpmn:task id="T_Entrada" name="Registrar la entrada de mercancía [P0]"><bpmn:incoming>E1</bpmn:incoming><bpmn:outgoing>E2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_EConteo" name="¿El producto tiene conteo?"><bpmn:incoming>E2</bpmn:incoming><bpmn:outgoing>E2b</bpmn:outgoing><bpmn:outgoing>E2c</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fin_ESinConteo" name="Rechazo: producto sin conteo (409 SIN_CONTEO)"><bpmn:incoming>E2b</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_GuardarEntrada" name="Guardar la entrada y actualizar el saldo [P0]"><bpmn:incoming>E2c</bpmn:incoming><bpmn:outgoing>E3</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="Fin_Entrada" name="Saldo actualizado"><bpmn:incoming>E3</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="Inicio" name="Necesidad de revisar el abastecimiento"><bpmn:outgoing>B1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="T_Tablero" name="Revisar existencias y rotación en el tablero [P0]"><bpmn:incoming>B1</bpmn:incoming><bpmn:outgoing>B2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Conteo" name="¿Es necesario hacer un conteo físico?"><bpmn:incoming>B2</bpmn:incoming><bpmn:outgoing>B3</bpmn:outgoing><bpmn:outgoing>B4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Conteo" name="Hacer y registrar el conteo físico [P0]"><bpmn:incoming>B3</bpmn:incoming><bpmn:outgoing>B5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_UneConteo"><bpmn:incoming>B4</bpmn:incoming><bpmn:incoming>B5</bpmn:incoming><bpmn:outgoing>B6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Sugeridos" name="Calcular las cantidades sugeridas (cobertura de 14 días) [P1]"><bpmn:incoming>B6</bpmn:incoming><bpmn:outgoing>B7</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Determinar" name="Revisar las sugerencias y decidir qué comprar"><bpmn:incoming>B7</bpmn:incoming><bpmn:outgoing>B8</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Pedido" name="¿Es necesario hacer un pedido?"><bpmn:incoming>B8</bpmn:incoming><bpmn:outgoing>B9</bpmn:outgoing><bpmn:outgoing>B10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fin_SinPedido" name="Fin sin pedido"><bpmn:incoming>B9</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Borrador" name="Crear el borrador del pedido [P1]"><bpmn:incoming>B10</bpmn:incoming><bpmn:outgoing>B11</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Aprobar" name="Aprobar el pedido [P1]"><bpmn:incoming>B11</bpmn:incoming><bpmn:outgoing>B12</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Reenvio"><bpmn:incoming>B12</bpmn:incoming><bpmn:incoming>B28</bpmn:incoming><bpmn:outgoing>B13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Enviar" name="Enviar el pedido por WhatsApp o llamada y marcarlo como ENVIADO [Manual / P1]"><bpmn:incoming>B13</bpmn:incoming><bpmn:outgoing>B14</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Amplia"><bpmn:incoming>B14</bpmn:incoming><bpmn:incoming>B24</bpmn:incoming><bpmn:outgoing>B15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:eventBasedGateway id="GW_Espera" name="Esperar la respuesta del proveedor [Manual]"><bpmn:incoming>B15</bpmn:incoming><bpmn:outgoing>B16</bpmn:outgoing><bpmn:outgoing>B17</bpmn:outgoing><bpmn:outgoing>B18</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="EV_Conf" name="Confirmación y fecha recibidas"><bpmn:incoming>B16</bpmn:incoming><bpmn:outgoing>B19</bpmn:outgoing><bpmn:messageEventDefinition id="MED_Conf" /></bpmn:intermediateCatchEvent>
<bpmn:task id="T_RegConf" name="Registrar la confirmación y la fecha estimada (CONFIRMADO) [P1]"><bpmn:incoming>B19</bpmn:incoming><bpmn:outgoing>B20</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="Fin_Conf" name="Pedido confirmado"><bpmn:incoming>B20</bpmn:incoming></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="EV_Falta" name="Proveedor sin disponibilidad"><bpmn:incoming>B17</bpmn:incoming><bpmn:outgoing>B21</bpmn:outgoing><bpmn:messageEventDefinition id="MED_Falta" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="EV_Timer" name="Pasan 30 minutos sin respuesta"><bpmn:incoming>B18</bpmn:incoming><bpmn:outgoing>B22</bpmn:outgoing><bpmn:timerEventDefinition id="TED_30min"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="GW_Hora" name="¿Ya pasó una hora desde el primer contacto con este proveedor?"><bpmn:incoming>B22</bpmn:incoming><bpmn:outgoing>B23</bpmn:outgoing><bpmn:outgoing>B24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="GW_UneCambio"><bpmn:incoming>B21</bpmn:incoming><bpmn:incoming>B23</bpmn:incoming><bpmn:outgoing>B25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="GW_Otro" name="¿Es el primer intento y hay otro proveedor disponible?"><bpmn:incoming>B25</bpmn:incoming><bpmn:outgoing>B26</bpmn:outgoing><bpmn:outgoing>B26b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Alt" name="Elegir otro proveedor [Manual]"><bpmn:incoming>B26</bpmn:incoming><bpmn:outgoing>B27</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Reintento" name="Cancelar con motivo y crear el reintento con el otro proveedor [P1]"><bpmn:incoming>B27</bpmn:incoming><bpmn:outgoing>B28</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Cancelar" name="Cancelar el pedido y registrar el motivo (CANCELADO) [P1]"><bpmn:incoming>B26b</bpmn:incoming><bpmn:outgoing>B26c</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="Fin_SinProveedor" name="Pedido cancelado sin reintento"><bpmn:incoming>B26c</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="Inicio_Atencion" name="Un cliente pide productos"><bpmn:outgoing>A1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_Atencion" /></bpmn:startEvent>
<bpmn:task id="T_Atencion" name="Registrar lo que pidió el cliente y lo que recibió [P0]"><bpmn:incoming>A1</bpmn:incoming><bpmn:outgoing>A2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Entrega" name="¿Se entregó alguna unidad?"><bpmn:incoming>A2</bpmn:incoming><bpmn:outgoing>A3</bpmn:outgoing><bpmn:outgoing>A4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_NoAtendida" name="Guardar la solicitud como demanda no atendida; el saldo no cambia [P0]"><bpmn:incoming>A3</bpmn:incoming><bpmn:outgoing>A3b</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="Fin_NoAtendida" name="Demanda no atendida registrada"><bpmn:incoming>A3b</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_SinConteo" name="¿El producto tiene conteo?"><bpmn:incoming>A4</bpmn:incoming><bpmn:outgoing>A4b</bpmn:outgoing><bpmn:outgoing>A4c</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fin_SinConteo" name="Rechazo: producto sin conteo (409 SIN_CONTEO)"><bpmn:incoming>A4b</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Saldo" name="¿Se entrega más de lo disponible?"><bpmn:incoming>A4c</bpmn:incoming><bpmn:outgoing>A4d</bpmn:outgoing><bpmn:outgoing>A4e</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fin_Rechazo" name="Rechazo: falta de saldo (409 STOCK_INSUFICIENTE)"><bpmn:incoming>A4d</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Guardar" name="Guardar la venta y actualizar saldo y estado [P0]"><bpmn:incoming>A4e</bpmn:incoming><bpmn:outgoing>A5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Umbral" name="¿El saldo llegó al nivel crítico con esta venta?"><bpmn:incoming>A5</bpmn:incoming><bpmn:outgoing>A6</bpmn:outgoing><bpmn:outgoing>A7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fin_SinAlerta" name="Venta registrada sin alerta"><bpmn:incoming>A6</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Alerta" name="Registrar la alerta como PENDIENTE y avisar a n8n [P0]"><bpmn:incoming>A7</bpmn:incoming><bpmn:outgoing>A8</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_UneRe"><bpmn:incoming>A8</bpmn:incoming><bpmn:incoming>A14b</bpmn:incoming><bpmn:outgoing>A8b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Correo" name="Enviar el correo de stock crítico al equipo [P0]"><bpmn:incoming>A8b</bpmn:incoming><bpmn:outgoing>A9</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Envio" name="¿n8n confirmó el envío en 10 segundos o menos?"><bpmn:incoming>A9</bpmn:incoming><bpmn:outgoing>A10</bpmn:outgoing><bpmn:outgoing>A11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Enviada" name="Marcar la alerta como ENVIADA [P0]"><bpmn:incoming>A10</bpmn:incoming><bpmn:outgoing>A12</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="Fin_Enviada" name="Alerta enviada"><bpmn:incoming>A12</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Fallida" name="Marcar la alerta como FALLIDA, sumar un intento y guardar el error [P0]"><bpmn:incoming>A11</bpmn:incoming><bpmn:outgoing>A13</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW_Intentos" name="¿Lleva menos de 3 intentos?"><bpmn:incoming>A13</bpmn:incoming><bpmn:outgoing>A14</bpmn:outgoing><bpmn:outgoing>A15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fin_Fallida" name="Alerta no enviada; la venta sigue guardada"><bpmn:incoming>A15</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_ReintAlerta" name="Reenviar más tarde con flask reintentar-alertas (mismo evento_id) [P0]"><bpmn:incoming>A14</bpmn:incoming><bpmn:outgoing>A14b</bpmn:outgoing></bpmn:task>
