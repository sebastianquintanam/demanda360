# =============================================================================
# Copia este archivo como .env (cp .env.example .env) y cambia TODO lo que
# empiece por "cambiar-". El archivo .env NUNCA se sube a GitHub.
# Generar un secreto:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

APP_ENV=production
SECRET_KEY=cambiar-por-un-secreto-largo
LOG_LEVEL=INFO
ORIGEN_DATOS=SIMULADO

# --- PostgreSQL ---
POSTGRES_DB=demanda360
POSTGRES_USER=demanda360
POSTGRES_PASSWORD=cambiar-clave-de-la-base
# Host y puerto para correr Flask o pytest FUERA de Docker (en el Mac).
# Dentro de Docker, compose.yaml los cambia a db:5432.
DB_HOST=localhost
DB_PORT=5432
# Puertos publicados en 127.0.0.1 (cámbialos si ya tienes algo usando 5432 u 8000)
DB_HOST_PORT=5432
WEB_HOST_PORT=8000

# --- n8n ---
N8N_ENCRYPTION_KEY=cambiar-clave-de-cifrado-n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/alerta-stock-critico
N8N_WEBHOOK_TOKEN=cambiar-token-del-webhook
# Fija la versión después del primer arranque (docker compose images) para que todos usen la misma
N8N_IMAGE_TAG=latest

# --- Usuarios demo (opcional: si se dejan vacías, `flask crear-usuarios-demo` las pide) ---
DEMO_PASSWORD_PROPIETARIO=
DEMO_PASSWORD_TRABAJADOR=
